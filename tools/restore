#!/usr/bin/env bash
# Restores an MCX Admin store from tools/backup's file into the MySQL container, replacing
# the database. Stop mcxadmin-server first and start it after: it applies any newer
# migrations, and its consumers re-apply what the outbox holds (docs/OPERATIONS.md).
#   tools/restore <mysql container> <in.sql>
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: tools/restore <mysql container> <in.sql>" >&2; exit 2; }
container=$1 in=$2
docker exec -i "$container" sh -c 'MYSQL_PWD=$(cat /run/secrets/mysql-root-password) exec mysql -h 127.0.0.1 -u root' < "$in"
echo "restored from $in"
